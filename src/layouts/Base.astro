---
import '../styles/global.css';
import { maps } from '../maps';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

const {
  title,
  description = 'Interactive atlases for fantasy worlds — search, measure and explore the lore behind every place.',
  fullBleed = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const analyticsConfigured = import.meta.env.PROD && Boolean(import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · LoreMaps</title>
  </head>
  <body class:list={[{ 'full-bleed': fullBleed }]}>
    <header class="site-header">
      <a class="brand" href="/">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" aria-hidden="true" viewBox="0 0 64 64">
            <circle cx="32" cy="14" r="7" fill="none" stroke="currentColor" stroke-width="4.5"/>
            <circle cx="32" cy="14" r="2" fill="currentColor"/>
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="5" d="M28.5 20.5 17 57M35.5 20.5 47 57"/>
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="3.5" d="M24 36.5c5-2 11-2 16 0"/>
          </svg>
        LoreMaps
      </a>
      <nav>
        {
          maps.map((m) => {
            const href = `/maps/${m.id}/`;
            return (
              <a href={href} aria-current={currentPath === href ? 'page' : undefined}>
                {m.title}
              </a>
            );
          })
        }
      </nav>
    </header>
    <slot />
    {
      !fullBleed && (
        <footer class="site-footer">
          <p>
            LoreMaps — map data and lore belong to their respective creators.&nbsp;
            <a href="/privacy/">Privacy &amp; cookies</a>&nbsp;·&nbsp;
            {
              analyticsConfigured && (
                <>
                  <button class="cookie-settings" type="button" data-cookie-settings>
                    Cookie settings
                  </button>
                  &nbsp;·&nbsp;
                </>
              )
            }
            <a href="https://github.com/loremaps/LoreMaps">Source on GitHub</a>
          </p>
        </footer>
      )
    }
    <CookieConsent />
  </body>
</html>
